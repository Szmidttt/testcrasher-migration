features = []

if CONFIG["MOZ_PHC"]:
    features += ["moz_phc"]

RustLibrary(
    "rust_testcrasher",
    features
)

OS_LIBS += [
    "ntdll",
]
# `std` uses `raw-dylib` to link this dll, but that doesn't work properly on x86 MinGW, so we explicitly
# have to link it.
if CONFIG["OS_ARCH"] == "WINNT" and CONFIG["CC_TYPE"] != "clang-cl":
    OS_LIBS += ["bcryptprimitives"]

